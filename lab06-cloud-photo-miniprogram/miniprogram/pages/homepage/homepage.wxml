<view class="page">
<view class="profile">
<view class="avatar large">{{profile ? profile.initial : '我'}}</view>
<view class="hero-title">{{profile ? profile.nickName : '我'}}的相册</view>
<view class="subtitle">{{profile ? profile.location : '从第一张照片开始，记录你的日常。'}}</view>
</view>
<view wx:if="{{error}}" class="notice">
<text>{{error}}</text>
<button class="small" bindtap="retry">重新连接</button>
</view>
<view wx:if="{{!loading && !error && !photos.length}}" class="empty">
<view class="empty-icon">＋</view>
<view class="section-title">相册的第一页，等你开启</view>
<view class="subtitle">分享一张照片，让美好被看见。</view>
<button class="primary" bindtap="add">上传第一张图片</button>
</view>
<view class="card" wx:for="{{photos}}" wx:key="_id">
<navigator class="row author" url="/pages/homepage/homepage?id={{item._openid}}">
<view class="avatar">{{item.initial}}</view>
<view>
<view class="name">{{item.nickName}}</view>
<view class="meta">{{item.location || '日常记录'}}</view>
</view>
<text class="arrow">↗</text>
</navigator>
<navigator url="/pages/detail/detail?id={{item._id}}">
<image class="photo" src="{{item.displayUrl}}" mode="widthFix" lazy-load/>
<view class="caption">
<view class="section-title">{{item.title}}</view>
<view class="meta">{{item.dateLabel}}</view>
</view>
</navigator>
</view>
<view class="footer" wx:if="{{loading}}">正在载入照片…</view>
<button wx:elif="{{hasMore && photos.length}}" class="small" bindtap="more">加载更多</button>
<view class="footer" wx:elif="{{photos.length}}">这一刻，已翻到最后。</view>
<button class="floating" bindtap="add">＋ 上传图片</button>
</view>
