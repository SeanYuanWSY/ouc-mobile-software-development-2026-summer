page{background:#f5f7f4;color:#233d34;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx}.page{padding:42rpx 32rpx 150rpx}.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:#718678;margin:12rpx 0 24rpx}.hero-title{font-size:52rpx;font-weight:600;line-height:1.35;letter-spacing:-1rpx;margin-bottom:20rpx}.green{color:#477e62;display:block}.subtitle{color:#728176;line-height:1.8;font-size:26rpx}.row{display:flex;align-items:center;gap:20rpx}.toolbar{justify-content:space-between;margin:48rpx 0 24rpx}.section-title{font-size:30rpx;font-weight:600}.card{background:white;border:1rpx solid #e4eae3;border-radius:28rpx;overflow:hidden;margin-bottom:30rpx}.author{padding:24rpx}.avatar{height:72rpx;width:72rpx;border-radius:50%;background:#e7eee2;color:#497052;display:flex;align-items:center;justify-content:center;font-size:30rpx;flex-shrink:0}.large{width:120rpx;height:120rpx;font-size:50rpx;margin:0 auto 24rpx}.profile{text-align:center;padding:24rpx 0 50rpx}.name{font-weight:600;font-size:27rpx}.meta{font-size:23rpx;color:#7c887d;margin-top:8rpx}.arrow{margin-left:auto;color:#81927d}.photo{width:100%;display:block;min-height:120rpx}.caption{padding:24rpx 26rpx 30rpx}.caption .meta{margin-top:14rpx}button{font-size:27rpx;border-radius:18rpx;background:#e8eee5;color:#314d3c;margin:0}button::after{border:none}.small{font-size:24rpx;line-height:2.8;padding:0 22rpx;display:inline-block}.primary{color:white;background:#355d48;padding:8rpx 20rpx;margin:24rpx 0}.floating{position:fixed;bottom:calc(30rpx + env(safe-area-inset-bottom));right:32rpx;background:#355d48;color:white;border-radius:60rpx;box-shadow:0 8rpx 30rpx #355d482a;padding:8rpx 32rpx}.empty{text-align:center;padding:72rpx 24rpx;background:#eef2e9;border-radius:28rpx;margin:24rpx 0}.empty-icon{font-size:70rpx;color:#90a184;margin-bottom:22rpx}.footer{text-align:center;color:#839080;padding:32rpx;font-size:23rpx}.notice{background:#fff2d9;color:#785825;padding:24rpx;border-radius:18rpx;margin:24rpx 0;line-height:1.7;overflow-wrap:break-word}.notice .small{display:block;margin-top:14rpx}.form{padding:24rpx;margin-top:32rpx}.picker{height:340rpx;background:#eef2e9;display:flex;align-items:center;justify-content:center;line-height:1.7}.picker image{width:100%;height:340rpx}.label{font-size:24rpx;font-weight:600;margin:30rpx 0 14rpx}input{padding:22rpx;background:#f6f8f3;border-radius:14rpx;font-size:27rpx}.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin-top:24rpx}.grid image{width:100%;height:208rpx;border-radius:16rpx}.grid text{display:block;font-size:22rpx;overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.detail-photo{width:100%;border-radius:24rpx;margin:14rpx 0 24rpx}.actions{margin-bottom:30rpx}.actions button{flex:1;font-size:25rpx}button[disabled]{opacity:.5}
