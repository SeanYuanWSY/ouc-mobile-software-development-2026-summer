page {
  background: #ffffff;
}

.progress-track {
  position: fixed;
  z-index: 99;
  top: 0;
  right: 0;
  left: 0;
  height: 6rpx;
  background: rgba(89, 99, 220, 0.1);
}

.progress-value {
  height: 100%;
  border-radius: 0 999rpx 999rpx 0;
  background: linear-gradient(90deg, #6674ed, #9a55dc, #ff7189);
  transition: width 180ms ease;
}

.article-shell {
  min-height: 100vh;
  padding-bottom: 80rpx;
  background: #ffffff;
}

.article-header {
  padding: 42rpx 32rpx 34rpx;
}

.article-kicker,
.article-meta,
.lead-quote,
.article-end,
.interaction-actions,
.round-action {
  display: flex;
  align-items: center;
}

.article-kicker {
  color: #667085;
  font-size: 22rpx;
  gap: 14rpx;
}

.category-pill {
  padding: 7rpx 17rpx;
  border-radius: 999rpx;
  background: #eef0ff;
  color: #4657c5;
  font-weight: 700;
}

.article-title {
  display: block;
  margin-top: 26rpx;
  color: #171b28;
  font-size: 50rpx;
  font-weight: 850;
  letter-spacing: -1rpx;
  line-height: 1.3;
}

.article-meta {
  margin-top: 32rpx;
}

.publisher-mark {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  margin-right: 16rpx;
  align-items: center;
  justify-content: center;
  border-radius: 19rpx;
  background: linear-gradient(145deg, #6875eb, #5b43c8);
  color: #ffffff;
  font-size: 27rpx;
  font-weight: 800;
  box-shadow: 0 10rpx 24rpx rgba(86, 72, 197, 0.23);
}

.publisher-name,
.publish-date,
.source-link {
  display: block;
}

.publisher-name {
  color: #34394b;
  font-size: 25rpx;
  font-weight: 700;
}

.publish-date {
  margin-top: 5rpx;
  color: #667085;
  font-size: 21rpx;
}

.source-link {
  display: inline-flex;
  min-height: 64rpx;
  padding: 0 8rpx;
  align-items: center;
  margin-top: 7rpx;
  color: #515db8;
  font-size: 21rpx;
  font-weight: 650;
}

.poster-frame {
  position: relative;
  width: calc(100% - 40rpx);
  margin: 0 20rpx;
  overflow: hidden;
  border-radius: 30rpx;
  background: #e9edf5;
  box-shadow: 0 18rpx 45rpx rgba(32, 42, 71, 0.16);
}

.poster-frame image {
  display: block;
  width: 100%;
}

.poster-label {
  position: absolute;
  right: 18rpx;
  bottom: 18rpx;
  padding: 8rpx 14rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
  border-radius: 999rpx;
  background: rgba(12, 16, 27, 0.55);
  color: rgba(255, 255, 255, 0.82);
  font-size: 16rpx;
  letter-spacing: 2rpx;
}

.article-content {
  padding: 42rpx 36rpx 30rpx;
}

.lead-quote {
  padding: 24rpx 25rpx;
  align-items: stretch;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #f2f3ff, #faf3ff);
  color: #51586c;
  font-size: 27rpx;
  font-weight: 650;
  line-height: 1.65;
}

.quote-line {
  width: 7rpx;
  margin-right: 18rpx;
  border-radius: 99rpx;
  background: linear-gradient(#6875eb, #a45bda);
}

.article-text {
  display: block;
  margin-top: 38rpx;
  color: #333949;
  font-size: 33rpx;
  letter-spacing: 1rpx;
  line-height: 2;
  text-align: justify;
}

.article-end {
  margin: 50rpx 0 10rpx;
  justify-content: center;
  color: #a7adba;
  font-size: 17rpx;
  letter-spacing: 4rpx;
  gap: 18rpx;
}

.end-line {
  width: 70rpx;
  height: 1rpx;
  background: #dfe3ea;
}

.interaction-card {
  margin: 0 24rpx;
  padding: 34rpx 26rpx 30rpx;
  border: 1rpx solid #e7eaf2;
  border-radius: 30rpx;
  background: linear-gradient(145deg, #fafbff, #f5f7fc);
  text-align: center;
}

.interaction-title,
.interaction-subtitle {
  display: block;
}

.interaction-title {
  color: #222738;
  font-size: 31rpx;
  font-weight: 800;
}

.interaction-subtitle {
  margin-top: 8rpx;
  color: #667085;
  font-size: 21rpx;
}

.interaction-actions {
  margin-top: 28rpx;
  justify-content: center;
  gap: 18rpx;
}

.round-action {
  width: 180rpx;
  height: 76rpx;
  margin: 0;
  padding: 0;
  justify-content: center;
  border: 1rpx solid #e1e5ed;
  border-radius: 999rpx;
  background: #ffffff;
  color: #656e7f;
  font-size: 22rpx;
  font-weight: 650;
  line-height: 76rpx;
  gap: 9rpx;
}

.round-action text:first-child {
  font-size: 31rpx;
}

.round-action.active.like {
  border-color: #ffd1dc;
  background: #fff0f4;
  color: #b4234a;
}

.round-action.active.favorite {
  border-color: #ffe3a0;
  background: #fff8e7;
  color: #765000;
}

.round-action.share {
  color: #5967d9;
}

.not-found {
  display: flex;
  width: 100%;
  min-height: 80vh;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #667085;
  font-size: 27rpx;
  text-align: center;
}

.not-found-icon {
  width: 100%;
  margin-bottom: 20rpx;
  color: #6975e4;
  font-size: 70rpx;
  text-align: center;
}

.not-found > text {
  display: block;
  width: 100%;
  text-align: center;
}
