<view class="progress-track">
  <view class="progress-value" style="width: {{readingProgress}}%;"></view>
</view>

<view wx:if="{{!notFound}}" class="article-shell">
  <view class="article-header">
    <view class="article-kicker">
      <text class="category-pill">{{article.category}}</text>
      <text>深度阅读 · {{article.reading_time}}</text>
    </view>
    <text class="article-title">{{article.title}}</text>
    <view class="article-meta">
      <view class="publisher-mark" aria-hidden="true">海</view>
      <view>
        <text class="publisher-name">{{article.source_name}}</text>
        <text class="publish-date">{{article.add_date}} · 青岛</text>
        <text class="source-link" bindtap="copySourceUrl" aria-role="button" aria-label="复制官方原文链接">复制官方原文链接 ↗</text>
      </view>
    </view>
  </view>

  <view class="poster-frame">
    <image src="{{article.poster}}" mode="widthFix" bindload="measureArticle" aria-hidden="true"></image>
    <view class="poster-label" aria-hidden="true">OUC · CAMPUS MOMENT</view>
  </view>

  <view class="article-content">
    <view class="lead-quote">
      <view class="quote-line"></view>
      <text>{{article.summary}}</text>
    </view>
    <text class="article-text">{{article.content}}</text>
    <view class="article-end">
      <view class="end-line"></view>
      <text>END</text>
      <view class="end-line"></view>
    </view>
  </view>

  <view class="interaction-card">
    <text class="interaction-title">这篇新闻打动你了吗？</text>
    <text class="interaction-subtitle">互动保存在本机；游客记录不会归入已保存资料</text>
    <view class="interaction-actions">
      <button class="round-action {{isLiked ? 'active like' : ''}}" bindtap="toggleLike" aria-label="{{isLiked ? '取消点赞' : '点赞'}}">
        <text>{{isLiked ? '♥' : '♡'}}</text>
        <text>{{isLiked ? '已点赞' : '点赞'}}</text>
      </button>
      <button class="round-action {{isFavorite ? 'active favorite' : ''}}" bindtap="toggleFavorite" aria-label="{{isFavorite ? '取消收藏' : '收藏这篇新闻'}}">
        <text>{{isFavorite ? '★' : '☆'}}</text>
        <text>{{isFavorite ? '已收藏' : '收藏'}}</text>
      </button>
      <button class="round-action share" open-type="share" aria-label="分享这篇新闻">
        <text>↗</text>
        <text>分享</text>
      </button>
    </view>
  </view>
</view>

<view wx:else class="not-found">
  <text class="not-found-icon">⌁</text>
  <text>没有找到这条新闻</text>
</view>
