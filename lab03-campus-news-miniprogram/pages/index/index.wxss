.home-page {
  min-height: 100vh;
  padding: 24rpx 24rpx 0;
  background:
    radial-gradient(circle at 88% 4%, rgba(111, 124, 255, 0.16), transparent 30%),
    linear-gradient(180deg, #f8f9fd 0%, #f3f5fa 100%);
}

.home-header,
.hero-topline,
.hero-actions,
.dashboard-row,
.dashboard-card,
.search-shell,
.category-row,
.section-heading,
.list-social {
  display: flex;
  align-items: center;
}

.home-header {
  justify-content: space-between;
  margin-bottom: 26rpx;
}

.eyebrow {
  display: block;
  color: #5260c2;
  font-size: 20rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.home-title {
  display: block;
  margin-top: 10rpx;
  color: #171b29;
  font-size: 40rpx;
  font-weight: 820;
  letter-spacing: -1rpx;
}

.header-profile {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 5rpx solid #ffffff;
  border-radius: 50%;
  background: linear-gradient(145deg, #6e7bff, #513bcf);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(72, 67, 177, 0.24);
}

.header-profile image {
  width: 100%;
  height: 100%;
}

.hero-stage {
  position: relative;
}

.hero-swiper {
  height: 590rpx;
  overflow: hidden;
  border-radius: 36rpx;
  box-shadow: 0 24rpx 64rpx rgba(34, 41, 78, 0.24);
}

.hero-card {
  position: relative;
  height: 100%;
  overflow: hidden;
  border-radius: 36rpx;
  background: #171b28;
}

.hero-card > image,
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background: linear-gradient(180deg, rgba(10, 13, 22, 0.08) 25%, rgba(10, 13, 22, 0.88) 100%);
}

.hero-topline {
  position: absolute;
  z-index: 2;
  top: 24rpx;
  right: 128rpx;
  left: 24rpx;
  justify-content: flex-start;
  color: #ffffff;
  font-size: 21rpx;
}

.hero-global-pause {
  position: absolute;
  z-index: 4;
  top: 20rpx;
  right: 20rpx;
  display: inline-flex;
  min-width: 88rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 999rpx;
  background: rgba(12, 16, 27, 0.72);
  color: #ffffff;
  font-size: 21rpx;
  font-weight: 700;
}

.now-badge {
  display: flex;
  height: 54rpx;
  padding: 0 18rpx;
  align-items: center;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  background: rgba(12, 16, 27, 0.4);
  color: #ffffff;
  font-weight: 650;
}

.now-dot {
  width: 12rpx;
  height: 12rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #9a89ff;
  box-shadow: 0 0 0 7rpx rgba(154, 137, 255, 0.22);
}

.hero-content {
  position: absolute;
  z-index: 2;
  right: 28rpx;
  bottom: 30rpx;
  left: 28rpx;
  color: #ffffff;
}

.hero-category {
  display: inline-block;
  padding: 8rpx 17rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #4656c8, #6b36aa);
  font-size: 21rpx;
  font-weight: 700;
}

.hero-title {
  display: block;
  margin-top: 18rpx;
  font-size: 42rpx;
  font-weight: 820;
  line-height: 1.3;
}

.hero-summary {
  display: -webkit-box;
  overflow: hidden;
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.7);
  font-size: 25rpx;
  line-height: 1.55;
  text-overflow: ellipsis;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hero-actions {
  margin-top: 24rpx;
  justify-content: space-between;
}

.immersive-entry {
  width: 252rpx;
  height: 70rpx;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 999rpx;
  background: #ffffff;
  color: #202438;
  font-size: 23rpx;
  font-weight: 750;
  line-height: 70rpx;
}

.hero-likes {
  display: inline-flex;
  min-height: 64rpx;
  padding: 0 12rpx;
  align-items: center;
  justify-content: center;
  font-size: 23rpx;
}

.hero-likes.active {
  color: #ffafc0;
}

.hero-pagination {
  display: flex;
  height: 34rpx;
  margin-top: -34rpx;
  padding: 0 28rpx;
  align-items: center;
  justify-content: flex-end;
  pointer-events: none;
  position: relative;
  z-index: 3;
  gap: 9rpx;
}

.hero-dot {
  width: 11rpx;
  height: 11rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.42);
  transition: width 220ms ease, background-color 220ms ease;
}

.hero-dot.active {
  width: 34rpx;
  background: #ffffff;
}

.dashboard-row {
  margin: 34rpx 0 22rpx;
  gap: 16rpx;
}

.dashboard-card {
  flex: 1;
  min-width: 0;
  height: 122rpx;
  padding: 0 20rpx;
  border-radius: 25rpx;
  color: #ffffff;
  box-shadow: 0 12rpx 30rpx rgba(36, 46, 86, 0.12);
}

.dashboard-card.violet {
  background: linear-gradient(135deg, #4656c8, #5b35b7);
}

.dashboard-card.coral {
  background: linear-gradient(135deg, #bd3152, #9f2342);
}

.dashboard-icon {
  margin-right: 17rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.dashboard-value,
.dashboard-label {
  display: block;
}

.dashboard-value {
  overflow: hidden;
  font-size: 25rpx;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dashboard-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.9);
  font-size: 20rpx;
}

.search-shell {
  height: 88rpx;
  padding: 0 22rpx;
  border: 1rpx solid #e9ecf3;
  border-radius: 27rpx;
  background: #ffffff;
  box-shadow: 0 9rpx 26rpx rgba(42, 52, 85, 0.06);
}

.search-icon {
  margin-right: 14rpx;
  color: #6670dd;
  font-size: 38rpx;
  font-weight: 700;
}

.search-shell input {
  flex: 1;
  color: #242838;
  font-size: 26rpx;
}

.search-shortcut {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #f0f2f8;
  color: #526071;
  font-size: 20rpx;
}

.category-scroll {
  width: calc(100% + 24rpx);
  margin: 20rpx -24rpx 0 0;
  white-space: nowrap;
}

.category-row {
  padding-right: 24rpx;
  gap: 12rpx;
}

.category-chip {
  display: inline-flex;
  height: 60rpx;
  padding: 0 25rpx;
  align-items: center;
  border: 1rpx solid #e4e8f0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.82);
  color: #667085;
  font-size: 23rpx;
  font-weight: 600;
}

.category-chip.active {
  border-color: transparent;
  background: #1e2232;
  color: #ffffff;
  box-shadow: 0 10rpx 22rpx rgba(30, 34, 50, 0.16);
}

.section-heading {
  margin: 34rpx 2rpx 18rpx;
  justify-content: space-between;
}

.section-title,
.section-subtitle {
  display: block;
}

.section-title {
  font-size: 35rpx;
  font-weight: 820;
}

.section-subtitle {
  margin-top: 4rpx;
  color: #667085;
  font-size: 18rpx;
  letter-spacing: 2rpx;
}

.section-arrow {
  display: inline-flex;
  min-height: 64rpx;
  padding: 0 10rpx;
  align-items: center;
  justify-content: center;
  color: #5260c2;
  font-size: 23rpx;
  font-weight: 700;
}

.feed-card {
  overflow: hidden;
  border: 1rpx solid #e8ebf2;
  border-radius: 28rpx;
  background: #ffffff;
  box-shadow: 0 14rpx 40rpx rgba(40, 49, 81, 0.07);
}

.list-social {
  color: #667085;
  font-size: 21rpx;
  gap: 15rpx;
}

.quick-like {
  display: inline-flex;
  min-width: 82rpx;
  min-height: 48rpx;
  padding: 8rpx 10rpx;
  align-items: center;
  justify-content: center;
  text-align: center;
  color: #667085;
  font-weight: 650;
}

.quick-like.active {
  color: #b4234a;
}
