page {
  min-height: 100%;
  color: #20243a;
  background: #f4f6fb;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", sans-serif;
}

button {
  margin: 0;
  padding: 0;
  font: inherit;
  line-height: normal;
}

button::after {
  border: 0;
}

.safe-bottom {
  height: calc(32rpx + env(safe-area-inset-bottom));
}
