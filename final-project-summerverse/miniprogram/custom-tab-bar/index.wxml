<view class="tabbar-wrap">
  <view class="tabbar">
    <button wx:for="{{list}}" wx:key="pagePath" class="tab-item {{selected === index ? 'is-active' : ''}} {{item.primary ? 'is-primary' : ''}}" data-index="{{index}}" bindtap="switchTab">
      <view class="tab-icon"><text>{{item.icon}}</text></view>
      <text class="tab-text">{{item.text}}</text>
    </button>
  </view>
</view>
