.memory-card { width:100%; display:grid; grid-template-columns:94rpx minmax(0,1fr) 122rpx; gap:14rpx; align-items:start; padding:22rpx 0; text-align:left; border-bottom:2rpx dashed rgba(83,74,61,.13); }
.memory-card:last-child { border-bottom:0; }
.memory-card.is-compact { grid-template-columns:84rpx minmax(0,1fr); }
.memory-time { position:relative; padding-right:20rpx; color:var(--muted); font-size:23rpx; text-align:right; }
.timeline-dot { position:absolute; right:-7rpx; top:8rpx; width:14rpx; height:14rpx; border-radius:50%; box-shadow:0 0 0 7rpx rgba(65,105,75,.08); }
.memory-body { min-width:0; padding-left:16rpx; border-left:2rpx solid rgba(86,76,63,.13); }
.memory-topline { display:flex; align-items:flex-start; gap:12rpx; }
.memory-title { flex:1; min-width:0; color:var(--ink); font-size:28rpx; font-weight:700; line-height:1.35; }
.memory-mood { font-size:28rpx; }
.memory-copy { display:-webkit-box; overflow:hidden; margin-top:8rpx; color:var(--muted); font-size:23rpx; line-height:1.55; -webkit-line-clamp:2; -webkit-box-orient:vertical; }
.memory-meta { display:flex; align-items:center; flex-wrap:wrap; gap:10rpx; margin-top:12rpx; }
.memory-category { padding:6rpx 12rpx; border-radius:999rpx; font-size:20rpx; }
.memory-location { max-width:220rpx; overflow:hidden; color:var(--muted); font-size:20rpx; text-overflow:ellipsis; white-space:nowrap; }
.demo-label { padding:4rpx 10rpx; border-radius:999rpx; color:#976a2c; background:#fff0d7; font-size:18rpx; }
.memory-cover { width:112rpx; height:112rpx; border:6rpx solid #fffaf0; border-radius:16rpx 12rpx 18rpx 13rpx; box-shadow:0 8rpx 18rpx rgba(65,50,31,.13); transform:rotate(1.5deg); }
.is-compact .memory-cover { display:none; }
