<view class="page page--no-tab relay-page {{experienceClass}}">
  <view class="nav-header"><button class="nav-back" bindtap="goBack" aria-label="返回">‹</button><view class="nav-title"><text class="nav-title__brand">电脑接力</text><text class="nav-title__sub">手机收集，电脑接着做。</text></view><button class="relay-small" bindtap="openConnections">连接</button></view>
  <view class="relay-intro"><text class="relay-headline">把资料交给电脑助手。</text><text class="relay-lead">选资料，写任务，结果回到手机。</text></view>
  <view class="relay-tabs"><button class="{{tab === 'dispatch' ? 'active' : ''}}" data-tab="dispatch" bindtap="switchTab" disabled="{{busy || loading}}">发起接力</button><button class="{{tab === 'jobs' ? 'active' : ''}}" data-tab="jobs" bindtap="switchTab" disabled="{{busy || loading}}">接力列表 · {{jobs.length}}</button></view>
  <view wx:if="{{error}}" class="relay-message"><text>{{error}}</text><button wx:if="{{!ready}}" class="relay-small" bindtap="bootstrap" disabled="{{loading || busy}}">重新连接</button></view>
  <text wx:if="{{notice}}" class="relay-notice">{{notice}}</text>
  <view wx:if="{{loading}}" class="relay-empty">正在读取连接与任务…</view>
  <block wx:elif="{{tab === 'dispatch'}}">
    <view wx:if="{{pending}}" class="relay-message"><text>上次交接的回执待确认。重试会使用相同请求，不另建任务。</text><button class="relay-small" bindtap="discardPending" disabled="{{busy}}">已核对列表，清除待确认表单</button></view>
    <view class="paper-card relay-section">
      <text class="relay-step">01 · 选择电脑</text>
      <picker wx:if="{{connections.length}}" range="{{connections}}" range-key="name" value="{{connectionIndex}}" bindchange="selectConnection" disabled="{{busy || pending}}"><view class="relay-picker"><text>{{connections[connectionIndex].name}}</text><text>⌄</text></view></picker>
      <view wx:else class="relay-empty"><text>还没有允许接收任务的电脑助手。</text><button class="secondary-button" bindtap="openConnections">连接我的电脑助手</button></view>
      <text class="relay-hint">只允许这个连接领取你指定的资料。</text>
    </view>
    <view class="paper-card relay-section">
      <text class="relay-step">02 · 选择资料</text>
      <picker wx:if="{{workspaces.length}}" range="{{workspaces}}" range-key="title" value="{{workspaceIndex}}" bindchange="selectWorkspace" disabled="{{busy || pending}}"><view class="relay-picker"><text>{{workspaces[workspaceIndex].title}}</text><text>⌄</text></view></picker>
      <view wx:else class="relay-empty"><text>先收好一份通知、文档或网页。</text><button class="secondary-button" bindtap="openMaterials">去资料工作台</button></view>
      <button wx:for="{{sources}}" wx:key="id" class="relay-source {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="changeSource" disabled="{{busy || pending}}" aria-label="{{item.selected ? '取消选择' : '选择'}}{{item.name}}"><text class="relay-check">{{item.selected ? '✓' : '○'}}</text><text class="relay-source-name">{{item.name}}</text><text class="relay-count">{{item.count}} 字</text></button>
      <text wx:if="{{sources.length}}" class="relay-hint {{characterCount > 12000 ? 'relay-limit' : ''}}">已选 {{sourceCount}} 份 · {{characterCount}} / 12000 字</text>
    </view>
    <view class="paper-card relay-section">
      <text class="relay-step">03 · 写下要做的事</text>
      <view class="recipe-list"><button wx:for="{{recipes}}" wx:key="title" data-index="{{index}}" bindtap="chooseRecipe" disabled="{{busy || pending}}">{{item.title}}</button></view>
      <textarea class="input relay-prompt" value="{{prompt}}" bindinput="onPrompt" maxlength="1000" disabled="{{busy || pending}}" placeholder="例如：结合我电脑上正在做的项目，检查这条通知里的新要求，补充说明并把结果回传。" aria-label="给电脑助手的任务要求"/>
      <button class="primary-button relay-submit" bindtap="createJob" loading="{{busy}}" disabled="{{busy || !ready || (!pending && (!sourceCount || characterCount > 12000 || !connections.length))}}">{{pending ? '核对并重试交接' : '确认资料，发起接力 ↗'}}</button>
      <text class="relay-hint">电脑助手领取后处理，结果会回到这里。</text>
    </view>
  </block>
  <block wx:elif="{{tab === 'jobs'}}">
    <view class="relay-section-top"><text class="relay-heading">我的接力</text><button class="relay-small" bindtap="refreshQueue" disabled="{{busy}}">刷新状态</button></view>
    <view wx:if="{{!jobs.length}}" class="paper-card relay-empty"><text>还没有接力任务。</text><text class="relay-hint">从“发起接力”选择资料和电脑助手。</text></view>
    <button wx:for="{{jobs}}" wx:key="id" class="paper-card relay-job" data-id="{{item.id}}" bindtap="openJob" disabled="{{busy}}"><view class="relay-job-top"><text class="relay-job-name">{{item.title}}</text><text class="relay-state state-{{item.status}}">{{item.statusLabel}}</text></view><text class="relay-job-copy">{{item.prompt || '这次接力已结束'}}</text><text class="relay-hint">{{item.connectionName}} · {{item.sourceCount}} 份资料</text></button>
    <view wx:if="{{detail}}" class="paper-card relay-section relay-detail">
      <view class="relay-section-top"><text class="relay-heading">{{detail.title}}</text><text class="relay-state state-{{detail.status}}">{{detail.statusLabel}}</text></view>
      <text wx:if="{{detail.prompt}}" class="relay-detail-prompt">{{detail.prompt}}</text>
      <block wx:if="{{detail.status === 'queued' || detail.status === 'running'}}"><button class="secondary-button" bindtap="copyInstructions">复制给电脑助手的话</button><text class="relay-hint">已配置 MCP 后，粘贴给你的电脑助手。页面不会自动轮询。</text></block>
      <view wx:if="{{detail.result}}" class="relay-result"><text class="relay-step">AI 辅助结果 · 请核对</text><text class="relay-result-title">{{detail.result.title}}</text><text class="relay-result-text" selectable>{{detail.result.text}}</text><button wx:for="{{detail.result.evidence}}" wx:key="index" class="relay-citation" data-index="{{index}}" bindtap="showEvidence">↗ 查看原文出处 {{index + 1}}</button><button class="secondary-button" bindtap="copyResult">复制结果与出处</button><button wx:if="{{detail.status === 'review'}}" class="primary-button relay-submit" bindtap="acceptJob" loading="{{busy}}" disabled="{{busy}}">已看过，采纳这份结果</button></view>
      <button wx:if="{{detail.status !== 'cancelled'}}" class="relay-small cancel-relay" bindtap="cancelJob" disabled="{{busy}}">{{detail.status === 'accepted' ? '清除这次接力内容' : '取消这次接力'}}</button>
    </view>
  </block>
  <button class="relay-help-toggle" bindtap="toggleHelp">{{showHelp ? '收起连接说明 ▴' : '它怎样连接我的电脑？ ▾'}}</button>
  <view wx:if="{{showHelp}}" class="paper-card relay-section"><text class="relay-help">1. 在“连接”里创建允许接收手机任务的凭证。
2. 在你自己的电脑 AI 客户端配置本项目的 MCP 适配器。
3. 手机发任务；让电脑助手领取、处理并回传。

仅交接所选资料。电脑客户端使用的模型、文件和工具权限由你自己配置。连接撤销后不能继续访问，但无法收回已经取走的内容。</text><button class="secondary-button" bindtap="openConnections">管理电脑连接</button></view>
  <view wx:if="{{evidenceOpen}}" class="relay-overlay" catchtap="closeEvidence"><view class="relay-evidence" catchtap="noop"><view class="relay-section-top"><text class="relay-heading">{{evidenceOpen.name}}</text><button class="relay-small" bindtap="closeEvidence">关闭</button></view><scroll-view scroll-y class="relay-evidence-scroll"><text class="relay-hint">{{evidenceOpen.locator}} · 发起时的资料快照</text><text class="relay-quote" selectable>{{evidenceOpen.quote}}</text><text class="relay-result-text" selectable>{{evidenceOpen.text}}</text></scroll-view></view></view>
</view>
