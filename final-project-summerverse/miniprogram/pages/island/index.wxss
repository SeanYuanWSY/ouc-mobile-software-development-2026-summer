.island-header { display:flex; align-items:center; justify-content:space-between; gap:20rpx; margin-bottom:22rpx; }
.brand-block { flex:1 1 auto; min-width:0; }
.brand { display:block; font-family:"KaiTi","STKaiti",serif; font-size:48rpx; font-weight:700; line-height:1; letter-spacing:1rpx; }
.brand-sub { display:block; margin-top:9rpx; overflow:hidden; color:var(--muted); font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }
.island-stage { position:relative; height:480rpx; overflow:hidden; border-radius:38rpx; background:#dce9e6; box-shadow:0 22rpx 54rpx rgba(67,53,37,.16); }
.island-image,.island-vignette { position:absolute; inset:0; width:100%; height:100%; }
.island-vignette { background:linear-gradient(180deg,rgba(21,34,37,.06) 30%,rgba(21,28,27,.62)); pointer-events:none; }
.stage-2 .island-vignette { background:linear-gradient(180deg,rgba(15,18,40,.04) 22%,rgba(12,17,36,.7)); }
.stage-chip { position:absolute; top:18rpx; left:18rpx; display:flex; align-items:center; gap:7rpx; min-height:54rpx; padding:0 17rpx; border:1rpx solid rgba(255,255,255,.55); border-radius:999rpx; color:#3d4b42; background:rgba(255,252,244,.9); font-size:20rpx; box-shadow:0 8rpx 20rpx rgba(32,39,34,.12); }
.stage-chip__dot { opacity:.45; }
.weather-chip { position:absolute; top:18rpx; right:18rpx; width:auto; max-width:46%; min-height:54rpx; display:flex; align-items:center; gap:9rpx; padding:7rpx 16rpx; border:1rpx solid rgba(255,255,255,.55); border-radius:999rpx; background:rgba(255,252,244,.9); box-shadow:0 8rpx 20rpx rgba(32,39,34,.12); }
.weather-icon { font-size:25rpx; flex:0 0 auto; }
.weather-temp { display:block; color:#334238; font-size:21rpx; font-weight:700; line-height:1.1; }
.weather-label { display:block; max-width:170rpx; overflow:hidden; color:#6f766f; font-size:16rpx; text-overflow:ellipsis; white-space:nowrap; }
.hero-copy { position:absolute; left:24rpx; right:24rpx; bottom:24rpx; color:#fffdf7; text-shadow:0 3rpx 10rpx rgba(20,28,26,.3); }
.hero-copy__kicker { display:block; font-size:17rpx; letter-spacing:3rpx; opacity:.78; }
.hero-copy__title { display:block; max-width:570rpx; margin-top:8rpx; font-family:"KaiTi","STKaiti",serif; font-size:34rpx; font-weight:700; line-height:1.35; }
button.start-card { width:100%; min-width:0; min-height:112rpx; display:flex; align-items:center; gap:16rpx; margin:18rpx 0 0; padding:18rpx 22rpx; text-align:left; border-radius:27rpx; color:#365b43; background:#e5efe1; }
.start-card__plus { width:60rpx; height:60rpx; display:grid; place-items:center; flex:0 0 auto; border-radius:20rpx; color:#fff; background:#3d7a55; font-size:40rpx; }
.start-card>view { flex:1; min-width:0; }
.start-card .text-strong { display:block; font-size:25rpx; }
.start-card .text-small { display:block; margin-top:5rpx; color:#6d7d70; font-size:19rpx; }
.start-card__arrow { flex:0 0 auto; font-size:38rpx; }
.data-line { display:flex; align-items:center; gap:10rpx; margin-top:18rpx; padding:4rpx 6rpx; font-size:21rpx; color:#7d7869; }
.data-cats { flex:1; min-width:0; }
.data-cats__row { display:flex; gap:16rpx; }
button.data-cat { width:auto; flex:0 0 auto; padding:4rpx 0; color:#4a463c; font-size:21rpx; font-weight:600; }
.data-line__sep,.data-line__dot { flex:0 0 auto; color:#c8c0ae; }
button.data-plain,.data-plain { width:auto; flex:0 0 auto; padding:4rpx 0; color:#4a463c; font-size:21rpx; }
.main-actions { margin-top:14rpx; }
button.main-action { width:100%; min-width:0; min-height:136rpx; display:flex; align-items:center; gap:14rpx; padding:20rpx; border-radius:28rpx; text-align:left; }
.main-action>view { min-width:0; }
.main-action--record { color:#fff; background:linear-gradient(145deg,#4b8661,#2f6f4b); box-shadow:0 14rpx 28rpx rgba(47,111,75,.2); }
.main-action__icon { width:52rpx; height:52rpx; display:grid; place-items:center; flex:0 0 auto; border-radius:18rpx; background:rgba(255,255,255,.18); font-size:34rpx; }
.main-action__title { display:block; font-size:24rpx; font-weight:700; }
.main-action__copy { display:block; margin-top:6rpx; overflow:hidden; font-size:17rpx; line-height:1.35; opacity:.78; }
.link-row { display:flex; align-items:center; justify-content:center; gap:8rpx; margin-top:14rpx; font-size:21rpx; }
button.link-item { width:auto; flex:0 0 auto; display:flex; align-items:center; gap:6rpx; padding:6rpx 4rpx; color:#57755f; font-size:21rpx; }
.link-item__avatar { width:30rpx; height:30rpx; border-radius:10rpx; }
.link-row__sep,.link-row__dot { color:#c8c0ae; }
.recent-list { margin-top:4rpx; }
.recent-card { overflow:hidden; border:1rpx solid var(--line); border-radius:28rpx; background:rgba(255,252,244,.78); }
button.recent-memory { width:100%; min-width:0; display:flex; align-items:center; gap:14rpx; padding:18rpx 20rpx; text-align:left; border-bottom:1rpx solid rgba(83,74,61,.1); }
.recent-memory:last-child { border-bottom:0; }
.recent-icon { width:54rpx; height:54rpx; display:grid; place-items:center; flex:0 0 auto; border-radius:17rpx; font-size:26rpx; }
.recent-copy { flex:1; min-width:0; }
.recent-title,.recent-meta { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.recent-title { font-size:24rpx; font-weight:700; }
.recent-meta { margin-top:5rpx; color:var(--muted); font-size:18rpx; }
.recent-arrow { flex:0 0 auto; color:var(--muted); font-size:34rpx; }
.no-memory-card { padding:28rpx 24rpx; text-align:center; }
.no-memory-title { display:block; font-size:25rpx; font-weight:700; }
.no-memory-copy { display:block; margin-top:7rpx; color:var(--muted); font-size:20rpx; }
ai-status { display:block; margin-top:16rpx; }
.onboarding-overlay { position:fixed; inset:0; z-index:180; display:grid; place-items:center; padding:40rpx 28rpx; background:rgba(40,37,31,.42); backdrop-filter:blur(12rpx); }
.onboarding-card { width:100%; max-width:650rpx; padding:58rpx 34rpx 34rpx; text-align:center; overflow:visible; }
.onboarding-skip { position:absolute; top:18rpx; right:20rpx; width:auto; color:var(--muted); font-size:21rpx; }
.onboarding-emoji { display:block; font-size:78rpx; }
.onboarding-title { display:block; margin-top:18rpx; font-family:"KaiTi","STKaiti",serif; font-size:36rpx; font-weight:700; line-height:1.35; }
.onboarding-copy { display:block; margin:14rpx auto 0; color:var(--muted); font-size:23rpx; line-height:1.65; }
.onboarding-dots { display:flex; justify-content:center; gap:10rpx; margin:24rpx 0; }
.onboarding-dot { width:12rpx; height:12rpx; border-radius:50%; background:#d8d0c2; }
.onboarding-dot.is-active { width:34rpx; border-radius:999rpx; background:var(--green); }
