<view class="page island-page {{experienceClass}}">
  <view class="island-header">
    <view class="brand-block"><text class="brand">SummerVerse</text><text class="brand-sub">{{profile.nickname}} · {{todayLabel}}</text></view>
    <button class="home-settings" bindtap="openSettings" aria-label="打开设置">⋯</button>
  </view>
  <view class="experience-selector"><button wx:for="{{experienceModes}}" wx:key="id" class="experience-option {{experienceMode === item.id ? 'is-selected' : ''}}" data-mode="{{item.id}}" bindtap="changeExperience" aria-label="切换为{{item.label}}模式">{{item.label}}</button></view>
  <view wx:if="{{loadError}}" class="home-error"><text>{{loadError}}</text><button class="small-button" bindtap="refresh">重试</button></view>

  <block wx:if="{{experienceMode !== 'journal'}}">
    <view class="workspace-hero">
      <text class="workspace-eyebrow">{{experienceMode === 'focus' ? '专注' : '电脑助手'}}</text>
      <text class="workspace-headline">{{experienceMode === 'focus' ? '先把眼前这一件做好。' : '把资料，变成下一步。'}}</text>
      <text class="workspace-description">{{experienceMode === 'focus' ? '从你确认过的任务开始。' : '手机收好，电脑接着做。'}}</text>
      <button wx:if="{{experienceMode === 'focus'}}" class="primary-button workspace-primary" bindtap="openFocus">选择一件事，开始专注 <text>↗</text></button>
      <button wx:else class="primary-button workspace-primary" bindtap="openComputer">连接我的电脑助手 <text>↗</text></button>
    </view>
    <button class="more-scenes" bindtap="toggleHomeActions">{{showHomeActions ? '收起更多场景' : '更多场景'}}</button>
    <view wx:if="{{showHomeActions && experienceMode === 'minimal'}}" class="studio-grid">
      <button class="studio-card" bindtap="openMaterials"><text class="studio-number">01</text><text class="studio-title">收好资料</text><text class="studio-copy">聊天文件、文字和链接</text><text class="studio-arrow">↗</text></button>
      <button class="studio-card" data-mode="plan" bindtap="openStudio"><text class="studio-number">02</text><text class="studio-title">拆解计划</text><text class="studio-copy">把要求拆成可做的事</text><text class="studio-arrow">↗</text></button>
      <button class="studio-card" data-mode="checklist" bindtap="openStudio"><text class="studio-number">03</text><text class="studio-title">提交前检查</text><text class="studio-copy">逐项核对交付要求</text><text class="studio-arrow">↗</text></button>
    </view>
    <view class="section-top workspace-section-title"><text class="workspace-section-heading">最近的资料</text><button class="small-button" bindtap="openMaterials">全部 ↗</button></view>
    <view class="workspace-library">
      <view wx:if="{{libraryError}}" class="home-error"><text>{{libraryError}}</text><button class="small-button" bindtap="refreshLibrary">重试</button></view>
      <text wx:elif="{{libraryLoading && !workspaces.length}}" class="library-empty">正在读取资料…</text>
      <button wx:for="{{workspaces}}" wx:key="id" class="workspace-row" data-id="{{item.id}}" bindtap="openWorkspace"><text class="workspace-dot">▤</text><view class="workspace-row-copy"><text class="workspace-row-title">{{item.title}}</text><text class="workspace-row-meta">{{item.sourceCount}} 份资料 · {{item.taskCount}} 个已确认任务</text></view><text>›</text></button>
      <view wx:if="{{!libraryLoading && !libraryError && !workspaces.length}}" class="library-empty"><text>从一条通知、一份课件开始。</text><text class="library-empty-sub">你保存过的资料会出现在这里。</text></view>
    </view>
    <view wx:if="{{showHomeActions}}" class="quiet-links"><button bindtap="startRecord">记一件事</button><button bindtap="openFocus">专注一下</button><button bindtap="openTwin">找小精灵</button></view>
  </block>

  <block wx:if="{{experienceMode === 'journal'}}">

  <view class="island-stage stage-{{stage}}">
    <image class="island-image" src="{{stageAsset}}" mode="aspectFill" />
    <view class="island-vignette"></view>
    <view class="stage-chip"><text>{{stageLabel}}</text><text class="stage-chip__dot">·</text><text>{{memoryCount}} 颗记忆</text></view>
    <button class="weather-chip" bindtap="syncWeather"><text class="weather-icon">{{weather ? weather.meta.icon : '📍'}}</text><view><text class="weather-temp">{{weather ? weather.temperature + '°' : '--°'}}</text><text class="weather-label">{{weather ? weather.meta.label : '点此获取天气'}}</text></view></button>
    <view class="hero-copy"><text class="hero-copy__kicker">TODAY · {{todayLabel}}</text><text class="hero-copy__title">{{stage === 0 ? '从第一颗记忆开始' : stage === 1 ? '你的小岛正在慢慢长大' : '每一盏灯，都是你走过的夏天'}}</text></view>
  </view>

  <button wx:if="{{stage === 0}}" class="start-card" bindtap="startRecord"><text class="start-card__plus">＋</text><view><text class="text-strong">记录第一件夏日小事</text><text class="text-small">一段话、一张照片或一个地点都可以</text></view><text class="start-card__arrow">›</text></button>

  <view wx:if="{{stage > 0}}" class="data-line">
    <scroll-view class="data-cats" scroll-x enable-flex><view class="data-cats__row"><button wx:for="{{categories}}" wx:key="key" wx:if="{{item.count > 0}}" class="data-cat" data-category="{{item.key}}" bindtap="openCategory">{{item.emoji}} {{item.short}} {{item.count}}</button></view></scroll-view>
    <text class="data-line__sep">｜</text>
    <button class="data-plain" bindtap="syncStep">👟 {{step ? step.steps : '--'}} 步</button>
    <text class="data-line__dot">·</text>
    <text class="data-plain data-plain--static">{{mood ? mood.emoji : '🌱'}} {{mood ? mood.name : '待记录'}}</text>
  </view>

  <view wx:if="{{stage > 0}}" class="main-actions">
    <button class="main-action main-action--record" bindtap="startRecord"><text class="main-action__icon">✎</text><view><text class="main-action__title">记一件事</text><text class="main-action__copy">文字 · 图片 · 语音 · 地点</text></view></button>
  </view>
  <button class="materials-entry" bindtap="openMaterials"><view class="materials-entry__mark">✦</view><view class="materials-entry__copy"><text class="materials-entry__title">把资料变成下一步</text><text class="materials-entry__hint">导入聊天文件 · 找要求 · 拆任务</text></view><text class="materials-entry__arrow">›</text></button>
  <view class="link-row">
    <button class="link-item link-item--twin" bindtap="openTwin"><image class="link-item__avatar" src="/images/twin-avatar-v2.jpg" mode="aspectFill" /><text>找 SummerTwin ›</text></button>
    <button class="link-item" bindtap="toggleHomeActions">{{showHomeActions ? '收起' : '更多'}}</button>
  </view>
  <view wx:if="{{showHomeActions}}" class="link-row link-row--secondary"><button class="link-item" bindtap="openMap">地图</button><text class="link-row__dot">·</text><button class="link-item" bindtap="openReport">报告</button><text class="link-row__dot">·</text><button class="link-item" bindtap="openSettings">设置</button></view>

  <view class="section-title"><text class="section-title__main">最近留下的记忆</text><text class="section-title__hint">{{latestMemories.length ? '点开即可回看' : '等待第一颗记忆'}}</text></view>
  <view wx:if="{{latestMemories.length}}" class="recent-list"><button wx:for="{{latestMemories}}" wx:key="_id" class="recent-memory" data-id="{{item._id}}" bindtap="openMemory"><view class="recent-icon" style="background:{{item.categoryMeta.soft}}">{{item.categoryMeta.emoji}}</view><view class="recent-copy"><text class="recent-title">{{item.title}}</text><text class="recent-meta">{{item.date}} · {{item.time}}{{item.location ? ' · ' + item.location.name : ''}}</text></view><text class="recent-arrow">›</text></button></view>
  <view wx:else class="recent-card no-memory-card"><text class="no-memory-title">这里会收好你的第一颗记忆</text><text class="no-memory-copy">写下今天的一件小事。</text></view>

  <ai-status ready="{{aiReady}}" label="{{aiReady ? 'AI 已连接' : '设置 AI'}}" bind:open="openSettings" />
  </block>

  <view wx:if="{{showOnboarding && experienceMode === 'journal'}}" class="onboarding-overlay"><view class="onboarding-card paper-card"><button class="onboarding-skip" bindtap="skipOnboarding">跳过</button><text class="onboarding-emoji">{{onboardingSlides[onboardingStep].emoji}}</text><text class="onboarding-title">{{onboardingSlides[onboardingStep].title}}</text><text class="onboarding-copy">{{onboardingSlides[onboardingStep].copy}}</text><view class="onboarding-dots"><view wx:for="{{onboardingSlides}}" wx:key="title" class="onboarding-dot {{index === onboardingStep ? 'is-active' : ''}}"></view></view><button class="primary-button" bindtap="nextOnboarding">{{onboardingStep === onboardingSlides.length - 1 ? '进入我的暑假小岛' : '继续'}}</button></view></view>
  <view wx:if="{{loading && experienceMode === 'journal'}}" class="loading-mask"><view class="paper-card loading-card"><text class="loading-sprout">🌱</text><text class="loading-text">正在读取你的暑假小岛…</text></view></view>
</view>
