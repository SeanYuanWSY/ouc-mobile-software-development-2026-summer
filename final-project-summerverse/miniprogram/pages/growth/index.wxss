.hero-stats { display:grid; grid-template-columns:repeat(3,1fr); gap:12rpx; }
.hero-stat { min-height:170rpx; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:18rpx 8rpx; }
.hero-icon { font-size:34rpx; }
.hero-value { margin-top:8rpx; font-family:"KaiTi","STKaiti",serif; font-size:40rpx; font-weight:700; }
.hero-label { margin-top:3rpx; color:var(--muted); font-size:19rpx; }
.goal-form { padding:28rpx 24rpx; }
.goal-form-row { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }
.goal-save { margin-top:22rpx; }
.goal-list { display:grid; gap:16rpx; }
.goal-card { padding:22rpx; }
.goal-card.is-complete { background:linear-gradient(145deg,rgba(255,252,244,.96),rgba(229,240,226,.94)); }
.goal-top { display:flex; align-items:center; gap:14rpx; }
.goal-icon { width:62rpx; height:62rpx; display:grid; place-items:center; flex:0 0 auto; border-radius:20rpx; font-size:31rpx; }
.goal-copy { flex:1; min-width:0; }
.goal-title { display:block; font-size:27rpx; font-weight:700; }
.goal-meta { display:block; margin-top:5rpx; color:var(--muted); font-size:20rpx; }
.goal-menu { width:54rpx; height:54rpx; color:var(--muted); font-size:36rpx; }
.goal-progress { height:12rpx; margin-top:18rpx; overflow:hidden; border-radius:999rpx; background:#e7e0d4; }
.goal-progress-fill { height:100%; border-radius:inherit; }
.goal-action { width:100%; min-height:64rpx; margin-top:14rpx; border:2rpx dashed rgba(61,122,85,.24); border-radius:18rpx; color:var(--green); background:#edf4e9; font-size:23rpx; font-weight:700; }
.goal-action.is-done { color:#7d786e; border-color:rgba(80,70,56,.15); background:#ede9df; }
.mood-chart { padding:30rpx 20rpx 22rpx; }
.chart-bars { height:290rpx; display:grid; grid-template-columns:repeat(7,1fr); align-items:end; gap:10rpx; }
.chart-column { height:100%; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; }
.chart-bar-shell { width:36rpx; height:190rpx; display:flex; align-items:flex-end; border-radius:999rpx; background:#ebe5da; overflow:hidden; }
.chart-bar { width:100%; min-height:12%; border-radius:999rpx; background:linear-gradient(180deg,#e9b85e,#72a177); }
.chart-empty { width:100%; height:8rpx; background:#d7d0c4; }
.chart-value { margin-top:8rpx; font-size:18rpx; }
.chart-label { margin-top:4rpx; color:var(--muted); font-size:17rpx; }
.insight-card { padding:28rpx 24rpx; }
.insight-placeholder { display:block; color:var(--muted); font-size:23rpx; line-height:1.65; margin-bottom:20rpx; }
.insight-headline { display:block; font-family:"KaiTi","STKaiti",serif; font-size:32rpx; font-weight:700; line-height:1.4; }
.insight-list { display:grid; gap:10rpx; margin-top:18rpx; color:var(--muted); font-size:23rpx; }
.insight-action { margin-top:20rpx; padding:18rpx; border-radius:20rpx; background:#edf4e9; }
.insight-action text { display:block; color:var(--green); font-size:19rpx; }
.insight-action .text-strong { display:block; margin-top:6rpx; font-size:24rpx; line-height:1.5; }
