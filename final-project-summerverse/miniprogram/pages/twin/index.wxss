.twin-header { display:flex; align-items:center; justify-content:space-between; gap:18rpx; }
.twin-header>view { min-width:0; }
.twin-brand { display:block; font-family:"KaiTi","STKaiti",serif; font-size:46rpx; font-weight:700; }
.twin-sub { display:block; margin-top:7rpx; overflow:hidden; color:var(--muted); font-size:22rpx; text-overflow:ellipsis; white-space:nowrap; }
.status-row { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10rpx; margin:18rpx 2rpx 14rpx; }
.evidence-note { color:var(--muted); font-size:19rpx; }
.garden-stage { position:relative; height:460rpx; overflow:hidden; border-radius:38rpx; box-shadow:0 22rpx 54rpx rgba(67,53,37,.16); }
.garden-image,.garden-shade { position:absolute; inset:0; width:100%; height:100%; }
.garden-shade { background:linear-gradient(180deg,transparent 55%,rgba(29,31,24,.42)); }
.stage-2 .garden-shade { background:linear-gradient(180deg,rgba(8,15,25,.03),rgba(7,14,22,.54)); }
.garden-badge { position:absolute; left:20rpx; bottom:30rpx; display:flex; align-items:center; justify-content:space-between; gap:20rpx; min-width:205rpx; min-height:52rpx; padding:0 16rpx; border:1rpx solid rgba(255,255,255,.65); border-radius:999rpx; color:#3d4b42; background:rgba(255,252,244,.88); font-size:20rpx; box-shadow:0 8rpx 20rpx rgba(32,39,34,.14); backdrop-filter:blur(8rpx); }
.garden-progress { position:absolute; left:20rpx; right:20rpx; bottom:16rpx; }
.garden-progress-track { height:7rpx; overflow:hidden; border-radius:999rpx; background:rgba(255,255,255,.32); }
.garden-progress-fill { height:100%; border-radius:inherit; background:#ffe7a5; }
.twin-speech { position:relative; z-index:3; display:flex; align-items:flex-start; gap:14rpx; margin:-8rpx 16rpx 0; padding:20rpx; border-radius:25rpx; background:#fffaf0; box-shadow:0 14rpx 34rpx rgba(66,52,35,.12); }
.twin-speech image { width:60rpx; height:60rpx; flex:0 0 auto; border-radius:20rpx; }
.twin-speech>view { flex:1; min-width:0; }
.speech-label { display:block; color:var(--green); font-size:20rpx; font-weight:700; }
.speech-copy { display:block; margin-top:6rpx; color:#514b42; font-size:22rpx; line-height:1.55; }
button.section-link { width:auto; flex:0 0 auto; color:var(--green); font-size:19rpx; }
.feature-scroll { width:100%; mask-image:linear-gradient(90deg,#000 86%,rgba(0,0,0,.25) 97%,transparent 100%); -webkit-mask-image:linear-gradient(90deg,#000 86%,rgba(0,0,0,.25) 97%,transparent 100%); }
.feature-row { display:flex; gap:14rpx; padding:2rpx 30rpx 10rpx 2rpx; }
button.feature-card { width:286rpx; min-width:286rpx; flex:0 0 auto; overflow:hidden; border-radius:28rpx; background:#fffaf0; text-align:left; box-shadow:0 9rpx 24rpx rgba(66,52,35,.09); }
.feature-card image { display:block; width:100%; height:170rpx; }
.feature-card>view { padding:16rpx 18rpx 19rpx; }
.feature-title { display:block; font-size:24rpx; font-weight:700; }
.feature-copy { display:block; margin-top:5rpx; color:var(--muted); font-size:18rpx; line-height:1.4; }
.chat-card { overflow:hidden; }
.chat-list { height:500rpx; padding:22rpx 20rpx; }
.chat-message { min-width:0; display:flex; align-items:flex-start; gap:10rpx; margin-bottom:18rpx; }
.chat-message.is-user { justify-content:flex-end; }
.chat-avatar { width:54rpx; height:54rpx; flex:0 0 auto; border:4rpx solid #f7f0e1; border-radius:19rpx; }
.chat-bubble { max-width:78%; min-width:0; padding:16rpx 18rpx; border:1rpx solid var(--line); border-radius:8rpx 22rpx 22rpx 22rpx; background:#fffaf0; font-size:23rpx; line-height:1.62; overflow-wrap:anywhere; }
.is-user .chat-bubble { color:#fff; border-color:#467a57; border-radius:22rpx 8rpx 22rpx 22rpx; background:#467a57; }
.is-pending .chat-bubble { color:var(--muted); border-style:dashed; }
.chat-source { display:block; margin-top:8rpx; color:#8b857a; font-size:17rpx; }
.is-user .chat-source { color:rgba(255,255,255,.65); }
.quick-question-scroll { width:100%; padding:0 18rpx 14rpx; }
.chat-composer { display:flex; align-items:flex-end; gap:12rpx; padding:16rpx; border-top:1rpx solid rgba(83,74,61,.12); background:rgba(248,242,231,.72); }
.chat-input { flex:1; min-width:0; min-height:74rpx; max-height:180rpx; padding:17rpx; border:1rpx solid var(--line); border-radius:20rpx; background:#fffdf8; font-size:24rpx; line-height:1.5; }
button.chat-send { width:auto; min-width:104rpx; height:74rpx; display:grid; place-items:center; flex:0 0 auto; border-radius:20rpx; color:#fff; background:var(--green); font-size:23rpx; font-weight:700; }
.trait-card { padding:26rpx 22rpx; }
.trait-row { display:grid; grid-template-columns:145rpx minmax(0,1fr); align-items:center; gap:16rpx; margin-bottom:18rpx; }
.trait-name { display:flex; align-items:center; justify-content:space-between; gap:8rpx; }
.trait-name text { font-size:23rpx; font-weight:700; }
.trait-name .text-small { color:var(--muted); font-size:19rpx; }
.trait-track { height:13rpx; overflow:hidden; border-radius:999rpx; background:#e7e0d4; }
.trait-fill { height:100%; border-radius:inherit; }
.first-call { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:18rpx; margin-top:18rpx; padding:20rpx; }
.first-call>text { color:var(--muted); font-size:22rpx; }
.first-call button { width:auto; flex:0 0 auto; }
