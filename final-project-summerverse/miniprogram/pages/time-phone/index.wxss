.phone-hero { position:relative; height:390rpx; overflow:hidden; border-radius:34rpx; box-shadow:0 18rpx 44rpx rgba(68,51,32,.16); }
.phone-hero>image,.phone-hero__shade { position:absolute; inset:0; width:100%; height:100%; }
.phone-hero__shade { background:linear-gradient(180deg,rgba(32,29,23,.05) 38%,rgba(32,27,21,.68)); }
.phone-date-wrap { position:absolute; top:18rpx; left:18rpx; }
.phone-date { display:inline-flex; align-items:center; gap:12rpx; min-height:54rpx; padding:0 17rpx; border:1rpx solid rgba(255,255,255,.45); border-radius:999rpx; color:#4d453a; background:rgba(255,251,240,.92); font-size:20rpx; box-shadow:0 8rpx 20rpx rgba(46,35,22,.12); }
.phone-hero__copy { position:absolute; left:22rpx; right:22rpx; bottom:22rpx; color:#fff; font-size:22rpx; line-height:1.5; text-shadow:0 3rpx 10rpx rgba(35,29,21,.35); }
.phone-hero.is-calling { animation:ringStage .55s ease-in-out infinite alternate; }
@keyframes ringStage { to { transform:rotate(.35deg) scale(.997); } }
.rule-card { margin-top:14rpx; padding:18rpx 20rpx; border-radius:22rpx; background:#edf3e9; }
.rule-title { display:block; color:var(--green); font-family:"KaiTi","STKaiti",serif; font-size:27rpx; font-weight:700; }
.rule-copy { display:block; margin-top:6rpx; color:var(--muted); font-size:20rpx; line-height:1.55; }
.question-card { margin-top:18rpx; padding:24rpx; }
.question-label { display:block; font-family:"KaiTi","STKaiti",serif; font-size:29rpx; font-weight:700; }
.question-input { width:100%; min-height:120rpx; margin:16rpx 0; padding:18rpx; border:1rpx solid var(--line); border-radius:20rpx; background:rgba(255,255,255,.62); font-size:25rpx; line-height:1.6; }
.call-button { margin-top:18rpx; }
.answer-letter { margin-top:20rpx; padding:38rpx 28rpx 28rpx; overflow:visible; }
.letter-stamp { position:absolute; top:18rpx; right:22rpx; padding:7rpx 12rpx; border:2rpx solid rgba(183,92,79,.45); color:#b25c50; font-size:17rpx; transform:rotate(5deg); }
.letter-title { display:block; padding-right:150rpx; font-family:"KaiTi","STKaiti",serif; font-size:31rpx; font-weight:700; line-height:1.4; }
.letter-content { display:block; margin-top:18rpx; color:#50493f; font-size:25rpx; line-height:1.85; white-space:pre-wrap; overflow-wrap:anywhere; }
.evidence-box { display:grid; gap:8rpx; margin-top:24rpx; padding:18rpx; border-radius:18rpx; background:#edf3e9; color:#607064; font-size:19rpx; line-height:1.5; overflow-wrap:anywhere; }
.evidence-title { color:#3d7a55; font-weight:700; }
