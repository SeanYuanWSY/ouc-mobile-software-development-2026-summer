.focus-page { max-width: 1000rpx; margin: 0 auto; }
.focus-selectors { margin: 20rpx 0 30rpx; }
.focus-picker { display: flex; gap: 28rpx; align-items: center; padding: 20rpx 6rpx; border-bottom: 1rpx solid var(--line); color: var(--muted); font-size: 24rpx; }
.focus-picker__value { flex: 1; min-width: 0; text-align: right; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; color: var(--ink); }
.focus-card { padding: 36rpx 30rpx; border: 1rpx solid var(--line); border-radius: 30rpx; background: var(--paper); }
.focus-eyebrow { display: block; text-align: center; color: var(--green); font-weight: 600; font-size: 23rpx; letter-spacing: 3rpx; }
.focus-task-title { display: block; margin: 20rpx 0 14rpx; font-size: 38rpx; line-height: 1.45; font-weight: 700; overflow-wrap: anywhere; text-align: center; }
.focus-detail { display: block; color: var(--muted); font-size: 26rpx; line-height: 1.65; text-align: center; white-space: pre-wrap; }
.focus-clock { text-align: center; font-size: 120rpx; font-weight: 300; letter-spacing: 2rpx; font-variant-numeric: tabular-nums; margin-top: 30rpx; color: var(--ink); }
.focus-state { display: block; font-size: 25rpx; color: var(--muted); text-align: center; margin-bottom: 32rpx; }
.focus-durations { display: flex; gap: 12rpx; margin-bottom: 28rpx; }
button.focus-duration { flex: 1; min-width: 0; width: auto; padding: 18rpx 8rpx; border: 1rpx solid var(--line); border-radius: 18rpx; font-size: 25rpx; color: var(--muted); }
button.focus-duration.is-selected { color: var(--green); border-color: var(--green); background: var(--green-soft); font-weight: 600; }
button.focus-primary, button.focus-complete { white-space: normal; text-align: center; padding: 20rpx; min-height: 90rpx; }
.focus-complete { margin-top: 20rpx !important; }
button.focus-link { display: block; width: 100%; min-height: 80rpx; padding: 24rpx 10rpx; color: var(--green); font-size: 25rpx; }
.focus-provenance { display: block; background: var(--green-soft); border-radius: 18rpx; padding: 22rpx; font-size: 24rpx; line-height: 1.65; white-space: pre-wrap; }
.focus-empty { padding: 65rpx 25rpx; text-align: center; }
.focus-empty .primary-button { margin-top: 35rpx; }
.focus-footnote { display: block; font-size: 22rpx; line-height: 1.6; color: var(--muted); margin: 28rpx 12rpx; }
.focus-message { border-radius: 18rpx; padding: 22rpx; margin-bottom: 20rpx; line-height: 1.6; font-size: 25rpx; }
.focus-error { color: #8d342b; background: #faece8; }
.focus-message button { color: inherit; text-decoration: underline; min-height: 70rpx; width: 100%; }
.focus-notice { display: block; padding: 10rpx 8rpx 25rpx; font-size: 25rpx; line-height: 1.6; color: var(--green); }
