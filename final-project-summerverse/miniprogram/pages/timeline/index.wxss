.search-paper { display:flex; align-items:center; gap:12rpx; height:82rpx; padding:0 20rpx; border:2rpx solid var(--line); border-radius:24rpx 19rpx 26rpx 20rpx; background:rgba(255,252,244,.88); box-shadow:0 8rpx 22rpx rgba(65,50,31,.08); }
.search-icon { color:var(--green); font-size:42rpx; line-height:1; transform:rotate(-12deg); }
.search-input { flex:1; min-width:0; height:100%; font-size:27rpx; }
.search-count { color:var(--muted); font-size:21rpx; }
.filter-scroll { width:100%; margin:18rpx 0; }
.heatmap-card { padding:24rpx; }
.heatmap-head { display:flex; align-items:flex-end; justify-content:space-between; gap:14rpx; }
.heatmap-title { display:block; font-family:"KaiTi","STKaiti",serif; font-size:30rpx; font-weight:700; }
.heatmap-sub { display:block; margin-top:4rpx; color:var(--muted); font-size:19rpx; }
.heatmap-legend { color:var(--muted); font-size:18rpx; }
.heatmap-grid { display:grid; grid-template-columns:repeat(14,1fr); gap:8rpx; margin-top:20rpx; }
.heat-cell { height:28rpx; border-radius:7rpx 5rpx 8rpx 6rpx; background:#ebe5d8; }
.heat-cell.level-1 { background:#c9dbc9; }
.heat-cell.level-2 { background:#88b08f; }
.heat-cell.level-3 { background:#3f7957; }
.day-group { margin-top:20rpx; padding:26rpx 22rpx 8rpx; }
.day-head { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding:0 4rpx 10rpx; }
.day-label { font-family:"KaiTi","STKaiti",serif; font-size:32rpx; font-weight:700; }
.day-count { color:var(--muted); font-size:20rpx; }
.day-list { padding:0 4rpx; }
